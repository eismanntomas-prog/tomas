---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Record from '../../components/Record.astro';
import Pedigree from '../../components/Pedigree.astro';
import MobileTree from '../../components/MobileTree.astro';
import { people, families, lineByK, records, dateKey, href, statusClass } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(people).map((slug) => ({ params: { slug } }));
}
const p = people[Astro.params.slug];
const line = p.line ? lineByK[p.line] : null;
const recs = [...new Set(p.records)].filter((r) => records[r]).sort((a, b) => dateKey(records[a].date) - dateKey(records[b].date));
const path = [...p.path].reverse().filter(Boolean);
---
<Base title={p.name} description={`${p.name} ${p.years} – ${p.rel}`}>
  <div class="crumbs">
    {path.map((s, i) => <>{i > 0 && <span>→</span>}{s === p.slug ? <span>{people[s].name}</span> : <a href={href.person(s)}>{people[s].name.split(' ')[0]} {people[s].years}</a>}</>)}
  </div>
  <h1>{p.name}</h1>
  <div class="chips">
    {p.years && <span class="chip">{p.years}</span>}
    <span class="chip">{p.rel}</span>
    {line && <a class="chip" href={href.line(line.slug)}><span class="dot" style={`background:${line.color}`}></span>rod {line.name}</a>}
    <span class={`chip ${statusClass(p.st)}`}>{p.status}</span>
  </div>


  {p.perex && (
    <div class="perex">
      <h2 class="perex-h">V kostce</h2>
      {p.perex.uvod && <p class="perex-uvod">{p.perex.uvod}</p>}
      <ul>{p.perex.body.map((b) => <li>{b}</li>)}</ul>
      <p class="small muted">Vše v tomto rámečku je doloženo matričními zápisy níže nebo dobovými prameny (viz Prameny).</p>
    </div>
  )}

  {p.also.length > 0 && (
    <p class="note">V rodokmenu dvakrát – pedigree collapse: je předkem přes {p.children.map((c, i) => <>{i > 0 && ' i přes '}<PersonLink slug={c} /></>)}.
      Podruhé jako {p.also.map((a) => a.rel).join(', ')}.</p>
  )}
  {p.facts.length > 0 && <ul class="facts">{p.facts.map((f) => <li>{f}</li>)}</ul>}
  {p.note && <p class="note">{p.note}</p>}

  {p.doba && (
    <section class="doba">
      <h2>{p.doba.nadpis || (p.sex === 'M' ? 'Doba, ve které žil' : 'Doba, ve které žila')}</h2>
      {p.doba.uvod && <p class="lead-doba">{p.doba.uvod}</p>}
      {p.doba.vladci && (
        <div class="card"><h3>Kdo vládl</h3>
          <ul class="facts">{p.doba.vladci.map((v) => <li><strong>{v.obdobi}</strong> – {v.text}</li>)}</ul></div>
      )}
      {p.doba.udalosti && (
        <>
          <h3>Události jeho života</h3>
          <ol class="timeline">{p.doba.udalosti.map((u) => <li><span class="when">{u.rok}{u.vek !== undefined && u.vek !== null ? ` (${u.vek} let)` : ''}</span> <strong>{u.nadpis}</strong>{u.osobni && <span class="chip">rodina</span>}{u.mistni && <span class="chip chip-obec">obec</span>}<br /><span class="small">{u.text}</span></li>)}</ol>
        </>
      )}
      {p.doba.obrazky && p.doba.obrazky.length > 0 && (
        <>
          <h3>Dobové obrázky z okolí</h3>
          {[...new Set(p.doba.obrazky.map((o) => o.obdobi))].map((ob) => (
            <>
              <h4 class="doba-obdobi">{ob}</h4>
              <div class="doba-gal">
                {p.doba.obrazky.filter((o) => o.obdobi === ob).map((o) => (
                  <figure>
                    <a href={`/img/doba/${o.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/doba/${o.img}.jpg`} alt={o.popis} loading="lazy" /></a>
                    <figcaption>{o.popis}<span class="credit">{o.autor && <>{o.autor} · </>}{o.licence}{o.zdroj && <> · <a href={o.zdroj} target="_blank" rel="noopener">zdroj</a></>}</span></figcaption>
                  </figure>
                ))}
              </div>
            </>
          ))}
        </>
      )}
      {p.doba.zivot && p.doba.zivot.map((z) => <><h3>{z.nadpis}</h3>{z.odstavce.map((o) => <p>{o}</p>)}</>)}
      {p.doba.pozn && <p class="note">{p.doba.pozn}</p>}
      {p.doba.zdroje && <><h3>Prameny</h3><ul class="small">{p.doba.zdroje.map((z) => <li>{z}</li>)}</ul></>}
    </section>
  )}

  <h2>Rodina</h2>
  <div class="grid2">
    <div class="card">
      <h3>Rodiče</h3>
      <p>Otec: {p.father ? <PersonLink slug={p.father} /> : <span class="muted">{p.fatherUnknown ? 'neuveden (nemanželské dítě)' : 'zatím neznámý'}</span>}<br />
        Matka: {p.mother ? <PersonLink slug={p.mother} /> : <span class="muted">zatím neznámá</span>}</p>
      {p.family && <p class="small"><a href={href.family(p.family)}>Rodina, ze které pochází →</a></p>}
    </div>
    {p.child && (
      <div class="card">
        <h3>{p.sex === 'M' ? 'Manželka' : 'Manžel'} a dítě v linii</h3>
        <p>{p.spouse ? <PersonLink slug={p.spouse} /> : <span class="muted">{p.sex === 'F' && people[p.child]?.fatherUnknown ? 'otec dítěte neuveden' : 'neznámý partner'}</span>}<br />
          {p.children.length > 1 ? 'Děti' : 'Dítě'}: {p.children.map((c, i) => <>{i > 0 && ', '}<PersonLink slug={c} /></>)}</p>
        {p.deti && p.deti.length > 0 && <p class="small">Další děti: {p.deti.join(' · ')}</p>}
        {p.ownFamily && <p class="small"><a href={href.family(p.ownFamily)}>Jejich rodina →</a></p>}
      </div>
    )}
  </div>

  {p.side.length > 0 && (
    <>
      <h2>Příbuzní mimo přímou linii</h2>
      <div class="grid2">
        {p.side.map((s) => (
          <div class="card"><h3>{s.name}</h3><p class="small">{s.text}</p>
            {s.records.length > 0 && <p class="small">Zápisy: {s.records.filter((r) => records[r]).map((r, i) => <>{i > 0 && ' · '}<a href={href.record(r)}>{records[r].date}</a></>)}</p>}
          </div>
        ))}
      </div>
    </>
  )}

  <h2>Předci</h2>
  <div class="only-desktop"><Pedigree k={p.k} /></div>
  <div class="only-mobile"><MobileTree k={p.k} /></div>

  {p.docs.length > 0 && (
    <>
      <h2>Rodinné dokumenty</h2>
      <div class="docs">{p.docs.map((d) => <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>)}</div>
    </>
  )}

  <h2>Zápisy z matrik</h2>
  {recs.length ? <div class="recs">{recs.map((r) => <Record id={r} showPeople exclude={p.slug} />)}</div>
    : <p class="muted">K této osobě zatím nemáme vlastní matriční zápis – údaje pocházejí ze zápisů jejích dětí{p.st === 'fam' ? ' nebo od rodiny' : ''}.</p>}
</Base>
